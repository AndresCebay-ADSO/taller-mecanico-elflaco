APP_NAME="MotoTaller El Flaco"
# En el servidor: APP_ENV=production y APP_DEBUG=false (nunca true en producción)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Bogota
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@tallerflacos.com
# Si se deja vacío, el seeder genera una contraseña temporal y la muestra en consola
ADMIN_PASSWORD=

# Carpeta donde scripts\windows\respaldo.bat deja los respaldos. Con ella, el dashboard avisa si se detienen.
RESPALDOS_DIR=
# Carpeta de Google Drive (la misma RESPALDOS_NUBE de scripts\windows\config.bat)
RESPALDOS_NUBE=
RESPALDOS_DIAS_AVISO=3
# httpd.conf de Apache, si no está en la ruta de XAMPP (taller:verificar revisa que escuche solo en 127.0.0.1).
# APACHE_CONF=C:\xampp\apache\conf\httpd.conf

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily rota los logs y conserva LOG_DAILY_DAYS días
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# En producción: LOG_LEVEL=warning
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taller_el_flaco
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
